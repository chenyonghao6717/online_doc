{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "src",
    "outDir": "./dist",
    "declaration": true,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "composite": true
  },
  "include": ["src/**/*"]
}
